{
  "expo": {
    "name": "VacApp",
    "slug": "VacApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.migarzabal011.VacApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "VacApp necesita acceso a la camara para escanear codigos QR."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VacApp necesita acceso a tus fotos para subir imagenes de animales."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ce005b00-420c-4f7d-afa1-c087e47ce812"
      }
    }
  }
}